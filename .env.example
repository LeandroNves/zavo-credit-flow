# Painel administrativo — verificação só no servidor (API /api/admin/*).
# Não use import.meta.env com senha no front-end.
#
# Obrigatório para login admin:
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Gere com: openssl rand -hex 32  (ou outro segredo longo e aleatório)
ADMIN_SESSION_SECRET=

# Fallback local (mesmo .env.local do Vite): a API aceita estes nomes se os acima estiverem vazios.
# Evite commitar valores reais.
VITE_ADMIN_USERNAME=
VITE_ADMIN_PASSWORD=

# Opcional: rate limit persistente entre instâncias (recomendado em produção).
# Project Settings → API: URL e service_role (NUNCA no front-end).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Supabase (Project Settings → API no dashboard)
# Project URL → cole em VITE_SUPABASE_URL (ou SUPABASE_URL para a API admin)
# anon public → cole em VITE_SUPABASE_ANON_KEY (não use a service_role no front-end)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Cadastro com Supabase Auth: em Authentication → Providers → Email, desative
# “Confirm email” em desenvolvimento para o signUp retornar sessão na hora
# (senão o fluxo de salvar perfil + arquivos falha até o usuário confirmar o e-mail).
