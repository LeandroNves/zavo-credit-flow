# =============================================================================
# Zavo Credit Flow — variáveis de ambiente (copie para .env ou .env.local)
# Nunca commite arquivos .env com valores reais.
# =============================================================================

# --- Painel administrativo (somente servidor: Vercel / middleware local) ---
# Login e sessão validados em /api/admin/* — não coloque senha no front-end.
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Gere com: openssl rand -hex 32
ADMIN_SESSION_SECRET=

# Fallback local (mesmos valores do Vite em dev). Evite em produção.
VITE_ADMIN_USERNAME=
VITE_ADMIN_PASSWORD=

# --- Supabase: API admin (servidor) ---
# service_role = chave secreta (Project Settings → API). NUNCA use prefixo VITE_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Supabase: front-end (públicas no bundle — proteção via RLS no banco) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Supabase Auth (cadastro de clientes) ---
# Em desenvolvimento: Authentication → Providers → Email → desative "Confirm email"
# para o signUp retornar sessão imediata. Em produção, mantenha confirmação ativa.
