# Painel administrativo (obrigatório para /admin/login funcionar)
# Copie para .env.local e preencha — .env.local não deve ir para o repositório.
VITE_ADMIN_USERNAME=
VITE_ADMIN_PASSWORD=

# Supabase (Project Settings → API no dashboard)
# Project URL → cole em VITE_SUPABASE_URL
# anon public → cole em VITE_SUPABASE_ANON_KEY (não use a service_role no front-end)
# Sem essas variáveis, o app usa apenas localStorage no navegador.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
