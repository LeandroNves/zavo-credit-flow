{
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "build": {
    "serverExternalPackages": ["@sparticuz/chromium", "puppeteer-core"]
  },
  "functions": {
    "api/admin/generate-document.ts": {
      "maxDuration": 60,
      "includeFiles": "api/_lib/templates/**"
    }
  }
}
